# Supabase Edge Function secrets for the lab project
# Copy this to supabase/functions/.env and replace the placeholders.

SUPABASE_URL=https://YOUR_LAB_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_LAB_SUPABASE_SERVICE_ROLE_KEY
GMAIL_EMAIL=YOUR_LAB_GMAIL_ADDRESS
GMAIL_APP_PASSWORD=YOUR_LAB_GMAIL_APP_PASSWORD
