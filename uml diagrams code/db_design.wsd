@startuml

hide circle
skinparam objectAttributeIconSize 0
skinparam linetype ortho
skinparam NodeSep 150
skinparam RankSep 140



object "users" as users {
  uid: uuid <<PK>>
  full_name: text
  college: text
  email: text
  role: text
  created_at: timestamptz
}
'
object "ipr_applications" as applications {
  application_id: uuid <<PK>>
  ip_title: text
  project_title: text
  current_status: uuid<<FK>>
  ' for easy access of type (cached)
  current_status_type: StatusType 
  funding_source: text
  tech_gen: uuid <<FK>>
  application_number: text <<UNIQUE>>
  date_of_filing: date
  type_of_ip: IpType
  date_of_registration: date
  registration_year: int
  created_at: timestamptz
  updated_at: timestamptz
}

object "notifications" as notifs{
  notif_id: uuid <<PK>>
  user_id: uuid <<FK>>
  application_id: uuid <<FK>> | null
  title: text
  message: text
  is_read: boolean
  created_at: timestamptz
  read_at: timestamptz | null
}

object "ipr_statuses" as statuses {
  status_id: uuid <<PK>>
  application_id: uuid <<FK>>
  status_type: statusType
  deadline: date
  note: text
  created_at: timestamptz
}

object "ipr_files" as files {
  file_id: uuid <<PK>>
  application_id: uuid <<FK>>
  owner_id: uuid <<FK>>
  storage_path: text
  filename: text
  description: text | null
  file_type: text
  uploaded_at: timestamptz
  comments: text | null
}

object "inventors" as inv {
  inventor_id: uuid <<PK>>
  application_id: uuid <<FK>>
  user_id: uuid | null <<FK>>
  comments: text | null
  full_name: text
  email: text
  college: text
}

object "audit_logs"  as aud{
  user_id: uuid <<FK>>
  role: text
  action: text
  time_stampt: timestamptz
}

applications "1" -left- "*" files
users "*" -up- "*" applications
applications "1" -right- "*" statuses
applications "*" -- "*" inv
applications "1" -- "*" notifs
users "1" -right- "*" notifs
inv "1" -right- "1" users
users "1" -down- "*" aud

@enduml